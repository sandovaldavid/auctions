FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# System packages: build tools + Chromium runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    build-essential \
    curl \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libx11-xcb1 \
    libxcb-dri3-0 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-dev.txt ./
RUN pip install --upgrade pip && pip install -r requirements-dev.txt
RUN playwright install chromium --with-deps

COPY . .

# Download axe-core if not already present in the workspace copy
RUN [ -f tests/e2e/fixtures/axe.min.js ] || \
    (mkdir -p tests/e2e/fixtures && \
     curl -fsSL -o tests/e2e/fixtures/axe.min.js \
     https://cdnjs.cloudflare.com/ajax/libs/axe-core/4.10.2/axe.min.js)

CMD ["pytest", "tests/e2e/", "-v", "--browser", "chromium"]
