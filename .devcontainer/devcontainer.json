{
  "name": "Auctions - Django Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": false,
      "installOhMyZshConfig": false,
      "upgradePackages": false,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {}
  },
  "mounts": [
    "source=devcontainer-${localWorkspaceFolderBasename}-zsh-history,target=/commandhistory,type=volume"
  ],
  "containerEnv": {
    "DEVCONTAINER": "true",
    "ZSH_HISTORY_FILE": "/commandhistory/.zsh_history",
    "TERM": "xterm-256color"
  },
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "postStartCommand": "bash .devcontainer/scripts/post-start.sh",
  "forwardPorts": [8000, 5432],
  "portsAttributes": {
    "8000": {
      "label": "Django",
      "protocol": "http",
      "onAutoForward": "notify",
      "requireLocalPort": true
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent",
      "requireLocalPort": true
    }
  },
  "init": true,
  "runArgs": ["--security-opt", "label=disable"],
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "shutdownAction": "stopContainer",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.rulers": [88],
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "ms-python.black-formatter",
        "batisteo.vscode-django",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "GitHub.copilot"
      ]
    },
    "jetbrains": {
      "settings": {
        "org.jetbrains.plugins.terminal:app:TerminalOptionsProvider.myShellPath": "/usr/bin/zsh"
      }
    }
  }
}
